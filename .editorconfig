root = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120

# Compose: allow PascalCase @Composable functions
ktlint_function_naming_ignore_when_annotated_with = Composable

# Disable any rule with ktlint_standard_<rule-id> = disabled, e.g.:
# ktlint_standard_no-wildcard-imports = disabled